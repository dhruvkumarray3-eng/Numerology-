API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_ID=
SUPER_ADMIN_ID=
# Logger channel (all bot events are logged here)
LOG_CHANNEL_ID=-1004451890857
LOG_CHANNEL_ID_2=
# Force-join: main network channel
CHECK_CHANNELS=@RDXnetworkinghub
JOIN_URLS=https://t.me/RDXnetworkinghub
TERMS_URL=

# ---------------------------------------------------------
# OFFICIAL LINKS  (already hardcoded in config.py - override only if needed)
# ---------------------------------------------------------
# User support group
SUPPORT_URL=https://t.me/usersupportgroupby_vendors
# Owner / vendor master
OWNER_URL=https://t.me/Vendor_masterz
# Logger / updates channel link
UPDATES_URL=https://t.me/vendorsellings
# Main network channel (force-join)
MAIN_CHANNEL_URL=https://t.me/RDXnetworkinghub
# ---------------------------------------------------------
# PAYMENT  ->  ONLY USDT (BEP-20 / BNB Smart Chain)
# ---------------------------------------------------------
# Trust Wallet -> USDT -> BNB Smart Chain -> Receive -> copy address
TRUST_WALLET_ADDRESS=
# Optional: custom QR image URL or Telegram file_id.
# Leave blank -> bot auto-generates the QR from the address above.
TRUST_WALLET_QR=

USE_PREMIUM_EMOJIS=1

# ---------------------------------------------------------
# LZT MARKET  ->  "Buy TG Account" panel
# Powers ONLY the "Good Quality" and "Cheap" TG account stock.
# Get the token from lzt.market / lolz.guru -> Settings -> API.
# ---------------------------------------------------------
LZT_API_KEY=
# Fixed INR markup applied to automatically priced LZT items.
LZT_MARGIN=25.0

# ---------------------------------------------------------
# TEMPORASMS  ->  THE MAIN OTP KEY
# Powers ALL THREE product panels:
#   1) All Apps OTP Accounts (51 apps, app + country search)
#   2) TG Number Change
#   3) WhatsApp Accounts
# Buy it at temporasms.com -> Dashboard -> API Key.
# ---------------------------------------------------------
TEMPORASMS_API_KEY=
TEMPORASMS_BASE_URL=https://api.temporasms.com

# ---------------------------------------------------------
# OPTIONAL extra OTP fallbacks (NOT required if TEMPORASMS is set)
# ---------------------------------------------------------
FIVESIM_API_KEY=
SMSACTIVATE_API_KEY=
SMSPVA_API_KEY=
SMSMAN_API_KEY=
TEMPMAIL_API_KEY=

# ---------------------------------------------------------
# IMAP mailbox used to auto-read Telegram login codes
# ---------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------------------------------------------------------
# UI / CATALOG / SERVERS
# ---------------------------------------------------------
ALL_APPS_CATALOG_JSON=
SERVERS_CONFIG=Server-1|off|bulk,Server-2 (Good Quality TG)|on|nonspam,Server-3 (TG NUM change)|on|numchange,Server-4 (cheap phishing)|on|spam
DEFAULT_CURRENCY=INR
DEFAULT_LANGUAGE=en

# ---------------------------------------------------------
# PRODUCT PANELS  (WhatsApp / TG Number Change / All Apps OTP)
# All three panels run on TemporaSMS. Change the service slug
# only if your TemporaSMS dashboard uses a different code.
# ---------------------------------------------------------
TEMPORASMS_SERVICE_WHATSAPP=whatsapp
TEMPORASMS_SERVICE_NUMCHANGE=telegram
# All Apps OTP uses the selected app slug as the service; this is the default.
TEMPORASMS_SERVICE_ALLOTP=telegram
TEMPORASMS_COUNTRY_WHATSAPP=any
TEMPORASMS_COUNTRY_NUMCHANGE=any
TEMPORASMS_COUNTRY_ALLOTP=any

# ---------------------------------------------------------
# BOT IDENTITY  (RDX ID is built from this bot's own Telegram ID)
# ---------------------------------------------------------
BOT_BRAND_NAME=
RDX_ID_PREFIX=RDX

# ---------------------------------------------------------
# PROFIT ENGINE  (owner-only markup; users never see real cost)
# mode = percent | fixed ; currency = INR | USD (fixed mode)
# Change live in Telegram with /setmarkup or /setprofit
# ---------------------------------------------------------
DEFAULT_MARKUP_MODE=percent
DEFAULT_MARKUP_PERCENT=25
DEFAULT_MARKUP_FIXED=0
DEFAULT_MARKUP_CURRENCY=INR

# ---------------------------------------------------------
# MONGODB  (full user history: orders, deposits, redeems, events)
# Leave blank to run without MongoDB (SQLite only).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
# ---------------------------------------------------------
MONGO_URI=
MONGO_DB=numerology_bot

# ---------------------------------------------------------
# PREMIUM CUSTOM-EMOJI PACKS  (t.me/addemoji/<short-name>)
# Owner can also override live in-bot: /setpack <role> <link>
#   roles: flags (country flags) • apps (app icons) • misc (purchase/success)
# ---------------------------------------------------------
STICKER_PACK_FLAGS=FlagsEmoji2024
STICKER_PACK_APPS=ApplicationEmoji
STICKER_PACK_MISC=exppwebs_by_fStikBot
